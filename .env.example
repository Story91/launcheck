# ── SERV Reasoning (OBOWIĄZKOWE w każdym tracku) ─────────────────────────────
# Klucz z https://console.openserv.ai → Settings → Keys
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai
# Decyzja zespołu (2026-11-03): domyślnie najtańszy model, gpt-6-luna ($0.13/M in, $0.65/M out, 1M ctx)
SERV_MODEL=gpt-6-luna

# ── OpenServ platform / Agent SDK (opcjonalne, tylko jeśli rejestrujemy agenta) ─
OPENSERV_API_KEY=

# ── SAM.gov (domyślne źródło: przetargi federalne USA) ──────────────────────
# Domyślnie bez klucza: dzienny publiczny eksport CSV importuje cron /api/cron/sam-import do tabeli sam_notices.
# Klucz (opcjonalny fallback dla ogłoszeń spoza eksportu): sam.gov → Account Details → Public API Key
SAM_API_KEY=

# ── Dolphin (dphn.ai) – OpenAI-compatible inference, DeepSeek V4.1 Flash, 1M ctx ─
# Klucz: app.dphn.ai → wallet → Telegram bot → Redeem Code (kupon API10 = $10) → API Keys
DOLPHIN_API_KEY=
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# ── Reppo Evaluation API ─────────────────────────────────────────────────────
# Klucz generuje człowiek w konsoli https://eval.reppo.xyz (sidebar "API Key")
REPPO_EVAL_API_KEY=
REPPO_EVAL_BASE_URL=https://eval.reppo.xyz/api/v1
# Opcjonalnie: prepaid credit token z x402 lane (x402ck_...)
REPPO_CREDIT_TOKEN=

# ── Kite Agent Passport ──────────────────────────────────────────────────────
# Brak publicznego HTTP API – integracja przez CLI `kpass` / `ksearch` (JSON output)
# Testnet: chain 2368, rpc https://rpc-testnet.gokite.ai/, faucet https://faucet.gokite.ai
# apps/x402 (sprzedawca): portfel odbierający płatności + cena; upstream z bindingu Vercel WEB_INTERNAL_URL albo UPSTREAM_URL lokalnie
KITE_NETWORK=testnet
PAY_TO=
PRICE_USD=0.50
UPSTREAM_URL=http://localhost:3000/api/internal/report
KITE_RPC_URL=https://rpc-testnet.gokite.ai/
KITE_CHAIN_ID=2368

# ── Ogólne ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── apps/web ─────────────────────────────────────────────────────────────────
# Neon Postgres (pooled connection string)
DATABASE_URL=
# Shared secret between apps/x402 and the internal report endpoint
INTERNAL_SECRET=
# Day-1 decision (docs/superpowers/plans): Dolphin is NOT the primary extractor
DOLPHIN_PRIMARY=false
SERV_FALLBACK_MODEL=gpt-5.4-mini
SERV_EXTRACT_MODEL=gemini-3.1-flash-lite
# Reppo: sandbox=true → free placeholder verdicts (dev); false → real evaluations
REPPO_SANDBOX=true
# Vercel cron auth for /api/cron/reppo
CRON_SECRET=

# LaunCheck: public execution is opt-in; the owner controls Kite allowance separately.
NEXT_PUBLIC_APP_URL=http://localhost:3000
LAUNCHCHECK_LIVE=0
LAUNCHCHECK_LIVE_UNTIL=2026-11-15T23:59:00Z
LAUNCHCHECK_DAILY_CAP_USD=1.5
# Optional extra SERV prompt guard. Strict output/evidence validation is always on.
LAUNCHCHECK_PROMPT_GUARD=0
# Sensitive Vercel settings prepared by the owner. Never commit credential contents.
KPASS_CONFIG_JSON_B64=
KPASS_AGENT_JSON_B64=
KPASS_SESSIONS_JSON_B64=
